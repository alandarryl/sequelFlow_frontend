generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  sqlScript   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}